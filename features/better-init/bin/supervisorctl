#!/bin/ash

INIT_DIR="${SUPERVISORCTL_INIT_DIR:-/etc/init.d}"
RUN_DIR="${SUPERVISORCTL_RUN_DIR:-/var/run}"
PROC_DIR="${SUPERVISORCTL_PROC_DIR:-/proc}"
running_processes_cached=0

if [ -t 1 ]; then
  GREEN='\033[32m'
  RED='\033[31m'
  ENDCOLOR='\033[0m'
fi

cache_running_processes() {
  running_processes=' '
  for comm_file in "$PROC_DIR"/[0-9]*/comm; do
    [ -r "$comm_file" ] || continue
    IFS= read -r cached_name < "$comm_file" || cached_name=
    [ -n "$cached_name" ] || continue
    case "$running_processes" in
      *" $cached_name "*) ;;
      *) running_processes="$running_processes$cached_name " ;;
    esac
  done
  running_processes_cached=1
}

set_process_name() {
  case "$1" in
    klipper) process_name=klippy ;;
    *) process_name="$1" ;;
  esac
}

is_running() {
  set_process_name "$1"
  pid_file="$RUN_DIR/$process_name.pid"
  pid=

  if [ -r "$pid_file" ]; then
    IFS= read -r pid < "$pid_file" || pid=
    case "$pid" in
      ''|*[!0-9]*) ;;
      *) [ -d "$PROC_DIR/$pid" ] && return 0 ;;
    esac
  fi

  [ "$running_processes_cached" -eq 1 ] || cache_running_processes
  case "$running_processes" in
    *" $process_name "*) return 0 ;;
  esac
  return 1
}

print_process_status() {
  service="$1"
  if is_running "$service"; then
    printf "%-33s${GREEN}RUNNING${ENDCOLOR}\n" "$service"
  else
    printf "%-33s${RED}STOPPED${ENDCOLOR}\n" "$service"
  fi
}

print_usage() {
  echo "Usage: $0 [command] <service>"
  echo "commands include status stop start restart"
}

find_script_path() {
  requested_service="$1"
  script_path=
  for candidate in "$INIT_DIR/$requested_service" "$INIT_DIR/$requested_service"*; do
    [ -f "$candidate" ] || continue
    script_path="$candidate"
    return 0
  done
  return 1
}

run_service_action() {
  action="$1"
  requested_service="$2"
  if find_script_path "$requested_service"; then
    "$script_path" "$action"
  fi
}

print_all_service_statuses() {
  seen_services=' '
  for script_path in "$INIT_DIR"/*; do
    [ -f "$script_path" ] || continue
    service="${script_path##*/}"
    service="${service%_service}"
    case "$seen_services" in
      *" $service "*) continue ;;
    esac
    seen_services="$seen_services$service "
    print_process_status "$service"
  done
}

main() {
  action="$1"
  [ "$#" -gt 0 ] && shift
  case "$action" in
    status)
      if [ "$#" -lt 1 ]; then
        print_all_service_statuses
      else
        for service in "$@"; do
          print_process_status "$service"
        done
      fi
      ;;
    start|stop|restart)
      [ "$#" -eq 1 ] || {
        print_usage
        exit 1
      }
      run_service_action "$action" "$1"
      ;;
    *)
      print_usage
      exit 1
      ;;
  esac
}

main "$@"
