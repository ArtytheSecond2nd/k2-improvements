+
+  it('limits values to the backend range', () => {
+    expect(adjustMaterialOffset(-4.99, -0.05)).toBe(-5)
+    expect(adjustMaterialOffset(4.99, 0.05)).toBe(5)
+  })
+
+  it('stages only changed rows and then saves', () => {
+    const commands = buildMaterialOffsetSaveCommands(
