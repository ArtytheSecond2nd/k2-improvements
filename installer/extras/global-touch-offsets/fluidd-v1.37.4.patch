index 0000000..f188ecb
--- /dev/null
+++ b/src/util/__tests__/global-touch-offsets.spec.ts
@@ -0,0 +1,24 @@
+import { adjustTouchOffset, buildTouchOffsetSaveCommands } from '../global-touch-offsets'
+
+describe('global touch offsets', () => {
+  it('moves up toward zero and prevents a positive touch offset', () => {
+    expect(adjustTouchOffset(-0.05, 0.025)).toBe(-0.025)
+    expect(adjustTouchOffset(-0.005, 0.01)).toBe(0)
+  })
+
+  it('moves down to a more-negative touch offset', () => {
+    expect(adjustTouchOffset(-0.05, -0.025)).toBe(-0.075)
+  })
+
+  it('stages only changed models before saving', () => {
+    const models = [
+      { index: 0, name: 'DEFAULT', value: -0.05 },
+      { index: 1, name: 'TEXTURED_PEI', value: -0.06 }
+    ]
+
+    expect(buildTouchOffsetSaveCommands(models, { 0: -0.075, 1: -0.06 })).toEqual([
+      'K2_CARTOGRAPHER_GLOBAL_Z_STAGE INDEX=0 VALUE=-0.075',
+      'K2_CARTOGRAPHER_GLOBAL_Z_SAVE'
+    ])
+  })
+})
diff --git a/src/util/global-touch-offsets.ts b/src/util/global-touch-offsets.ts
new file mode 100644
index 0000000..8370d98
--- /dev/null
+++ b/src/util/global-touch-offsets.ts
@@ -0,0 +1,24 @@
+interface TouchOffsetModel {
+  index: number;
+  value: number;
+}
+
+export const adjustTouchOffset = (value: number, delta: number): number => {
+  const adjusted = Math.round((value + delta) * 1000) / 1000
+  return Math.min(0, adjusted)
+}
+
+export const buildTouchOffsetSaveCommands = (
+  models: TouchOffsetModel[],
+  workingOffsets: Record<number, number>
+): string[] => {
+  const commands = models
+    .filter(model => workingOffsets[model.index] !== model.value)
+    .map(model => (
+      `K2_CARTOGRAPHER_GLOBAL_Z_STAGE INDEX=${model.index} ` +
+      `VALUE=${workingOffsets[model.index].toFixed(3)}`
+    ))
+
+  commands.push('K2_CARTOGRAPHER_GLOBAL_Z_SAVE')
+  return commands
+}
